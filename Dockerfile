FROM golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS build
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X github.com/SRodi/kubectl-datapath/internal/version.Version=${VERSION}" \
    -o /out/kubectl-datapath ./cmd/kubectl-datapath

FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
COPY --from=build /out/kubectl-datapath /kubectl-datapath
ENTRYPOINT ["/kubectl-datapath"]
